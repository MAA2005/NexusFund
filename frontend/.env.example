# ─── IMPORTANT: These variables are bundled into your JavaScript and sent to
# every browser that visits your site. Do NOT put secrets here.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Backend API ──────────────────────────────────────────────────────────────
# Development: http://localhost:5000
# Production:  https://your-railway-backend-url.up.railway.app
VITE_API_URL=http://localhost:5000

# ─── Smart Contract ───────────────────────────────────────────────────────────
# Fill in after deploying contracts with Hardhat
VITE_CAMPAIGN_FACTORY_ADDRESS=fill_in_after_contract_deployment

# ─── Polygon Amoy Testnet ────────────────────────────────────────────────────
VITE_POLYGON_CHAIN_ID=80002
VITE_POLYGON_CHAIN_NAME=Polygon Amoy Testnet
VITE_POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
VITE_POLYGON_BLOCK_EXPLORER=https://amoy.polygonscan.com
VITE_POLYGON_CURRENCY_NAME=MATIC
VITE_POLYGON_CURRENCY_SYMBOL=MATIC
VITE_POLYGON_CURRENCY_DECIMALS=18

# ─── IPFS ─────────────────────────────────────────────────────────────────────
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
# Generate a Pinata JWT at: https://app.pinata.cloud/keys
# New Key → enable pinFileToIPFS → copy JWT
VITE_PINATA_JWT=your_pinata_jwt_token_here
