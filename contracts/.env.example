# ─── HOW TO USE THIS FILE ─────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Fill in every value below
# 3. NEVER commit the .env file — it is already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Your deployment wallet private key (WITHOUT the 0x prefix)
# Get from MetaMask: click account name → Account Details → Export Private Key
# WARNING: Use a dedicated deployment wallet. Never use your main funds wallet.
PRIVATE_KEY=your_64_character_private_key_without_0x_prefix

# Polygon Amoy testnet RPC URL
# Free tier from Alchemy (recommended): https://dashboard.alchemy.com/
# Or use the public endpoint (less reliable for production):
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Polygonscan API key — required to verify your contract source code publicly
# Get free key at: https://polygonscan.com/myapikey (register first)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# USDC contract address on Polygon Amoy testnet
# Verify the current address at: https://amoy.polygonscan.com (search "USDC")
# Circle's official test USDC on Amoy — confirm this before deployment
USDC_ADDRESS_AMOY=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582

# Wallet address that receives the 2.5% platform fee on successful withdrawals
# This is a wallet address (starts with 0x), NOT a private key
PLATFORM_FEE_RECEIVER=your_0x_wallet_address_here

# Set to "true" only when you want gas cost estimates during test runs
# Slows down tests significantly, so leave false during development
REPORT_GAS=false
