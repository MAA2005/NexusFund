generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Stores account data. wallet_address is optional because Phase 2 introduces
// custodial wallets — some users will never set up MetaMask themselves.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  password_hash         String
  country               String
  wallet_address        String?    @unique
  encrypted_private_key String?
  created_at            DateTime   @default(now())

  campaigns Campaign[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN
// goal_amount and raised amounts use Decimal(20,6) because USDC has 6 decimal
// places. Using Decimal instead of Float prevents floating-point rounding errors
// in financial calculations — a Float can silently misrepresent $1000.00 as
// $999.9999999 which would break the "goal reached" check.
// ─────────────────────────────────────────────────────────────────────────────
model Campaign {
  id               String         @id @default(cuid())
  title            String
  description      String
  goal_amount      Decimal        @db.Decimal(20, 6)
  deadline         DateTime
  creator_id       String
  contract_address String?        @unique
  image_url        String?
  category         String
  status           CampaignStatus @default(ACTIVE)
  created_at       DateTime       @default(now())

  creator   User       @relation(fields: [creator_id], references: [id])
  donations Donation[]

  @@index([creator_id])
  @@index([status])
  @@index([category])
  @@map("campaigns")
}

// ─────────────────────────────────────────────────────────────────────────────
// DONATION
// tx_hash must be unique — this prevents a race condition where a malicious
// user submits the same blockchain transaction twice to our API and gets
// double-counted. Prisma/PostgreSQL enforces this at the database level.
// ─────────────────────────────────────────────────────────────────────────────
model Donation {
  id           String   @id @default(cuid())
  campaign_id  String
  donor_wallet String
  amount_usdc  Decimal  @db.Decimal(20, 6)
  tx_hash      String   @unique
  created_at   DateTime @default(now())

  campaign Campaign @relation(fields: [campaign_id], references: [id])

  @@index([campaign_id])
  @@map("donations")
}

enum CampaignStatus {
  ACTIVE      // Accepting donations, deadline not passed
  SUCCESSFUL  // Deadline passed, goal was met
  FAILED      // Deadline passed, goal was NOT met (refunds available)
  WITHDRAWN   // Creator has withdrawn funds
}
