# ─── HOW TO USE THIS FILE ─────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Fill in every value below
# 3. NEVER commit the .env file — it is already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Production: Railway automatically injects this as $DATABASE_URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexusfund

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Must be a long random string — minimum 64 characters
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The exact URL of your frontend — no trailing slash
# Development: http://localhost:5173
# Production:  https://nexusfund.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your real Gmail password
# Generate at: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Pinata IPFS ──────────────────────────────────────────────────────────────
# Get these from: https://app.pinata.cloud/keys
# Click "New Key" → enable "pinFileToIPFS" and "pinJSONToIPFS"
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud

# ─── Blockchain ───────────────────────────────────────────────────────────────
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
CAMPAIGN_FACTORY_ADDRESS=fill_in_after_contract_deployment
USDC_CONTRACT_ADDRESS=fill_in_after_contract_deployment

# ─── Custodial Wallet Encryption ─────────────────────────────────────────────
# AES-256-GCM key for encrypting custodial wallet private keys in the DB
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CHANGE THIS IN PRODUCTION — use a strong random value, store it securely
WALLET_ENCRYPTION_KEY=replace_with_32_char_random_hex_string
